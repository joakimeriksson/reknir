FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including WeasyPrint requirements.
# postgresql-client must be at least the major version of the postgres server image:
# pg_dump refuses newer servers, and pg_restore cannot read dumps from a newer pg_dump
# (the backups made so far come from pg_dump 17, archive format 1.16).
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create directory for uploads (logos, attachments)
RUN mkdir -p /app/uploads

# Create non-root user and set ownership
RUN useradd -m -u 1000 reknir && \
    chown -R reknir:reknir /app

USER reknir

# Run migrations and start server
# Note: Alembic migrations require write access to /app directory
CMD alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
