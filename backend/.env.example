# Database Configuration
DATABASE_URL=postgresql://reknir:reknir@db:5432/reknir

# CORS Settings
# Comma-separated list of allowed origins.
# Note: this file is read directly by the backend (no docker compose),
# so values must be literal - e.g. with a public domain:
# CORS_ORIGINS=https://reknir.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application Settings
APP_NAME=Reknir - Swedish Bookkeeping

# Debug Mode (IMPORTANT)
# Set to False in production!
# When DEBUG=False:
# - Verification deletion is disabled (as per Swedish accounting regulations)
# - Only correcting entries should be used to fix errors
# When DEBUG=True:
# - Verification deletion is allowed (for development/testing only)
DEBUG=True
