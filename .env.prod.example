# =============================================================================
# REKNIR PRODUCTION ENVIRONMENT
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.prod.example .env
#
# NEVER commit .env to version control!

# =============================================================================
# Compose file – which stack plain "docker compose" commands should use
# =============================================================================

# With this set, "docker compose up -d" starts the production stack:
# postgres + backend + frontend + the nginx gateway (the single entry point,
# routing / to the frontend and /api to the backend).
# For the development stack, use .env.dev.example instead.
COMPOSE_FILE=docker-compose.prod.yml

# Optional: Cloudflare Tunnel (no exposed ports needed at all).
# Create a tunnel in the Cloudflare Zero Trust dashboard, point its Public
# Hostname at http://nginx:80, then uncomment and paste the tunnel token
# (see docs/CLOUDFLARE.md):
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=eyJ...

# =============================================================================
# Host & port – how the app is reached
# =============================================================================

# The address users type in the browser; CORS is derived from it.
# Examples:
#   APP_URL=https://reknir.example.com    (domain via reverse proxy or tunnel)
#   APP_URL=http://192.168.1.100:8080     (direct LAN access)
APP_URL=https://reknir.example.com

# The single published host port (the nginx gateway) – change if the port is
# taken. Point your reverse proxy (or browser) at http://<server>:NGINX_PORT
NGINX_PORT=80

# =============================================================================
# Database
# =============================================================================

# Credentials used by docker-compose to create the database.
# IMPORTANT: set a strong password BEFORE the first start - the postgres image
# only applies it when the data volume is first initialized.
# Generate with: openssl rand -base64 32
POSTGRES_USER=reknir
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=reknir

# =============================================================================
# Backend
# =============================================================================

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY

# Always False in production (disables verification deletion, per Swedish
# accounting regulations)
DEBUG=False

# =============================================================================
# Overrides – rarely needed
# =============================================================================

# CORS – derived automatically from APP_URL (falls back to * if unset).
# Uncomment only to override, e.g. to allow several origins:
# CORS_ORIGINS=https://reknir.example.com,https://www.reknir.example.com

# Frontend API URL (baked in at build time) – served same-origin via the
# gateway, so the relative default /api is right for almost everyone:
# VITE_API_URL=/api
