# =============================================================================
# Compose file – which stack plain "docker compose" commands should use
# =============================================================================

# With this set, "docker compose up -d" starts the development stack.
# For the production stack, use .env.prod.example instead.
COMPOSE_FILE=docker-compose.dev.yml

# =============================================================================
# Host & ports – how the app is reached
# =============================================================================

# Hostname or IP the app is accessed at from the browser. Keep localhost for
# local use; set your server's IP for network access
# (find it with: hostname -I | awk '{print $1}')
APP_HOST=localhost

# Host ports published by docker-compose.dev.yml – change if a port is taken
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# =============================================================================
# Database
# =============================================================================

# Credentials used by docker-compose to create the database
POSTGRES_USER=reknir
POSTGRES_PASSWORD=reknir
POSTGRES_DB=reknir

# =============================================================================
# Backend
# =============================================================================

# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-string

# Development default; the production template uses False
DEBUG=True

# =============================================================================
# Overrides – rarely needed
# =============================================================================

# CORS – derived automatically: http://APP_HOST:FRONTEND_PORT plus
# http://localhost:3000. Uncomment only to override:
# CORS_ORIGINS=http://192.168.1.100:5173,http://localhost:5173
# CORS_ORIGINS=https://reknir.example.com,http://localhost:5173

# Frontend API URL – derived automatically: http://APP_HOST:BACKEND_PORT/api
# Uncomment only to override:
# VITE_API_URL=http://192.168.1.100:8000/api
# VITE_API_URL=https://reknir.example.com/api
